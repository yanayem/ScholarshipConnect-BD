{
  "expo": {
    "name": "ScholarBD",
    "slug": "scholarshipconnectbd",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "scholarshipconnectbd",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "scholarships.bd",
      "googleServicesFile": "./app/google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#E6F7F5",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "name": "ScholarshipConnect-BD",
      "shortName": "ScholarshipBD",
      "description": "Connecting students to scholarships in Bangladesh",
      "themeColor": "#2A9D8F",
      "backgroundColor": "#E6F7F5",
      "display": "standalone",
      "orientation": "portrait"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2A9D8F",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-router",
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "@react-native-google-signin/google-signin"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "eas": {
        "projectId": "5de9b6c7-d0a0-4512-a392-1aef480dd164"
      }
    }
  }
}
